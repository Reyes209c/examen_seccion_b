    <changeSet id="002-2-insert-users" author="umg">
        <insert tableName="users">
            <column name="id" valueNumeric="1"/>
            <column name="username" value="admin"/>
            <column name="password" value="$2a$10$sJLPmgj80xBBVDWerwFQf.l0zi/B6wNKBEO6tNJVYcAZMYyZ3iOnC"/>
            <column name="full_name" value="Administrador del Sistema"/>
